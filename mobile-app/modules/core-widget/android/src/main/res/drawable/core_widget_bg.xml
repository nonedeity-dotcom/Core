<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон виджета с мягким краем: 8 вложенных прямоугольников, каждый чуть меньше предыдущего.
  Полупрозрачные слои складываются, поэтому у края фон почти прозрачный, а к середине
  плавно густеет до ~92%. Размытие в самих drawable недоступно, это его ступенчатая замена.

  Подстройка: ширина мягкого края = слоёв × шаг (сейчас 8 × 2dp), цвет — 15161D в каждом слое,
  общая плотность — по альфе первого и последнего слоя.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:left="0dp"
    android:top="0dp"
    android:right="0dp"
    android:bottom="0dp">
    <shape android:shape="rectangle">
      <solid android:color="#0A15161D" />
      <corners android:radius="28dp" />
    </shape>
  </item>
  <item
    android:left="2dp"
    android:top="2dp"
    android:right="2dp"
    android:bottom="2dp">
    <shape android:shape="rectangle">
      <solid android:color="#1C15161D" />
      <corners android:radius="26dp" />
    </shape>
  </item>
  <item
    android:left="4dp"
    android:top="4dp"
    android:right="4dp"
    android:bottom="4dp">
    <shape android:shape="rectangle">
      <solid android:color="#2C15161D" />
      <corners android:radius="24dp" />
    </shape>
  </item>
  <item
    android:left="6dp"
    android:top="6dp"
    android:right="6dp"
    android:bottom="6dp">
    <shape android:shape="rectangle">
      <solid android:color="#3D15161D" />
      <corners android:radius="22dp" />
    </shape>
  </item>
  <item
    android:left="8dp"
    android:top="8dp"
    android:right="8dp"
    android:bottom="8dp">
    <shape android:shape="rectangle">
      <solid android:color="#5015161D" />
      <corners android:radius="20dp" />
    </shape>
  </item>
  <item
    android:left="10dp"
    android:top="10dp"
    android:right="10dp"
    android:bottom="10dp">
    <shape android:shape="rectangle">
      <solid android:color="#6515161D" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item
    android:left="12dp"
    android:top="12dp"
    android:right="12dp"
    android:bottom="12dp">
    <shape android:shape="rectangle">
      <solid android:color="#7715161D" />
      <corners android:radius="16dp" />
    </shape>
  </item>
  <item
    android:left="14dp"
    android:top="14dp"
    android:right="14dp"
    android:bottom="14dp">
    <shape android:shape="rectangle">
      <solid android:color="#5415161D" />
      <corners android:radius="14dp" />
    </shape>
  </item>
</layer-list>
