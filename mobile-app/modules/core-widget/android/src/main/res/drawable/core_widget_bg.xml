<?xml version="1.0" encoding="utf-8"?>
<!--
  Фон виджета: нейтральное тёмное стекло, слегка прозрачное.
  8 вложенных прямоугольников, каждый на 1dp меньше предыдущего, у каждого ~23% непрозрачности.
  Слои складываются: у края фон ~23%, к середине густеет до ~88%, так что рисунок обоев
  чуть просвечивает, а текст остаётся читаемым. Тонкая светлая рамка у внешнего слоя.

  Подстройка: прозрачность — альфа в #3B (3B = 23%; больше — плотнее, меньше — прозрачнее),
  цвет — 141416 (нейтрально-чёрный; сделать светлее — например 1C1C1F).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:left="0dp"
    android:top="0dp"
    android:right="0dp"
    android:bottom="0dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <stroke android:width="1dp" android:color="#26FFFFFF" />
      <corners android:radius="28dp" />
    </shape>
  </item>
  <item
    android:left="1dp"
    android:top="1dp"
    android:right="1dp"
    android:bottom="1dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="27dp" />
    </shape>
  </item>
  <item
    android:left="2dp"
    android:top="2dp"
    android:right="2dp"
    android:bottom="2dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="26dp" />
    </shape>
  </item>
  <item
    android:left="3dp"
    android:top="3dp"
    android:right="3dp"
    android:bottom="3dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="25dp" />
    </shape>
  </item>
  <item
    android:left="4dp"
    android:top="4dp"
    android:right="4dp"
    android:bottom="4dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="24dp" />
    </shape>
  </item>
  <item
    android:left="5dp"
    android:top="5dp"
    android:right="5dp"
    android:bottom="5dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="23dp" />
    </shape>
  </item>
  <item
    android:left="6dp"
    android:top="6dp"
    android:right="6dp"
    android:bottom="6dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="22dp" />
    </shape>
  </item>
  <item
    android:left="7dp"
    android:top="7dp"
    android:right="7dp"
    android:bottom="7dp">
    <shape android:shape="rectangle">
      <solid android:color="#3B141416" />
      <corners android:radius="21dp" />
    </shape>
  </item>
</layer-list>
