<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/core_widget_row"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:paddingTop="8dp"
  android:paddingBottom="8dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/core_widget_mark"
      android:layout_width="26dp"
      android:layout_height="wrap_content"
      android:textColor="#8B8F98"
      android:textSize="17sp" />

    <TextView
      android:id="@+id/core_widget_label"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#E8E6E0"
      android:textSize="15sp" />

    <TextView
      android:id="@+id/core_widget_count"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingStart="8dp"
      android:textColor="#8B8F98"
      android:textSize="13sp" />
  </LinearLayout>

  <!-- Полоса родителя с подзадачами: сколько подзадач сделано. Для остальных строк скрыта. -->
  <ProgressBar
    android:id="@+id/core_widget_row_bar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:layout_marginStart="26dp"
    android:layout_marginTop="6dp"
    android:max="100"
    android:progress="0"
    android:progressDrawable="@drawable/core_widget_bar"
    android:visibility="gone" />
</LinearLayout>
