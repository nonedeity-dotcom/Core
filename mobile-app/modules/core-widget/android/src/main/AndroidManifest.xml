<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="expo.modules.corewidget">

  <!--
    Виджет «Сегодня» на рабочем столе. Всё не экспортировано: обновления виджета ему шлёт
    система от имени самого приложения, а нажатия приходят через PendingIntent этого же
    приложения — чужим сюда стучаться незачем.
  -->
  <application>
    <receiver
      android:name="expo.modules.corewidget.HabitsWidgetProvider"
      android:exported="false"
      android:label="Core — сегодня">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/core_habits_widget" />
    </receiver>

    <!-- Поставщик строк для прокручиваемого списка в виджете. -->
    <service
      android:name="expo.modules.corewidget.WidgetListService"
      android:exported="false"
      android:permission="android.permission.BIND_REMOTEVIEWS" />

    <!--
      Невидимая развилка для нажатий: раскрыть привычку, свернуть её или открыть приложение.
      Своя задача (taskAffinity пустой), чтобы раскрытие подзадач не вытаскивало приложение
      на экран.
    -->
    <activity
      android:name="expo.modules.corewidget.WidgetActionActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.NoDisplay" />
  </application>

</manifest>
